# Copy to .env and fill in. Never commit .env.

# --- Cloudflare (step 15: go live) ---
# Starts the cloudflared container alongside the app.
# COMPOSE_PROFILES=tunnel
# From Zero Trust > Networks > Tunnels > your tunnel > Install connector (the long token after --token).
TUNNEL_TOKEN=
# Your Zero Trust team domain, e.g. maazin.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag from Zero Trust > Access > Applications > Grab > Overview.
CF_ACCESS_AUD=
# Optional second check on the signed-in email (Access already restricts it).
ALLOWED_EMAIL=

# --- Or: Tailscale instead of Cloudflare ---
# Trusts the signed-in user that `tailscale serve` passes along; set ALLOWED_EMAIL to your Tailscale login.
# AUTH_MODE=tailscale
# Starts the tailscale container, which joins your tailnet as the device "grab".
# COMPOSE_PROFILES=tailscale
# Optional: an auth key from the Tailscale admin console. Without one, open the login link from
# `docker compose logs tailscale` on first start.
# TS_AUTHKEY=

# --- App ---
# true skips the Access token check. Only for local testing; never with the tunnel on.
DEV_MODE=false
# Host port for local checks (bound to 127.0.0.1 only).
GRAB_PORT=8000
# Defaults shown.
# EXPIRY_HOURS=24
# DISK_FLOOR_GB=5
# JOB_GAP_S=5
